{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "${BOT_APP_ID}",
  "developer": {
    "name": "Contoso",
    "websiteUrl": "https://${TEAMS_HOST}",
    "privacyUrl": "https://${TEAMS_HOST}/privacy",
    "termsOfUseUrl": "https://${TEAMS_HOST}/terms"
  },
  "name": {
    "short": "camp_buddy",
    "full": "camp_buddy - Market Campaign Analytics Assistant"
  },
  "description": {
    "short": "Ask questions about campaign data",
    "full": "AI-powered assistant that queries Databricks Genie Space for market campaign analytics — performance metrics, ROI, spend breakdowns, audience segments, and more."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#0078D4",
  "bots": [
    {
      "botId": "${BOT_APP_ID}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "help",
              "description": "Get help on how to use this bot"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": [
    "${TEAMS_HOST}"
  ]
}